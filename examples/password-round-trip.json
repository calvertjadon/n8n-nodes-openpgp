{
  "name": "OpenPGP example: password round trip",
  "nodes": [
    {
      "parameters": {
        "content": "## Runs without credentials\nThis workflow encrypts and decrypts text with the obvious demo-only password `example-only-password-change-me`. Replace it before adapting this workflow. A production Password should come from an appropriate secret source rather than workflow JSON."
      },
      "id": "setup-note",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-20, -260]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "When clicking Execute workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { message: 'OpenPGP password round trip' } }];"
      },
      "id": "sample-message",
      "name": "Create Sample Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "encrypt",
        "sourceData": "text",
        "textToEncrypt": "={{ $json.message }}",
        "encryptUsing": "password",
        "password": "example-only-password-change-me",
        "outputAs": "text",
        "outputFieldName": "ciphertext",
        "options": {}
      },
      "id": "encrypt",
      "name": "Encrypt With Password",
      "type": "n8n-nodes-openpgp.openPgp",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "operation": "decrypt",
        "sourceData": "text",
        "textToDecrypt": "={{ $json.ciphertext }}",
        "decryptUsing": "password",
        "password": "example-only-password-change-me",
        "outputAs": "text",
        "outputFieldName": "plaintext",
        "options": {}
      },
      "id": "decrypt",
      "name": "Decrypt With Password",
      "type": "n8n-nodes-openpgp.openPgp",
      "typeVersion": 1,
      "position": [660, 0]
    }
  ],
  "connections": {
    "When clicking Execute workflow": {
      "main": [[{"node": "Create Sample Message", "type": "main", "index": 0}]]
    },
    "Create Sample Message": {
      "main": [[{"node": "Encrypt With Password", "type": "main", "index": 0}]]
    },
    "Encrypt With Password": {
      "main": [[{"node": "Decrypt With Password", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
